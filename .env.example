# Required
MONGODB_URI=
NEXTAUTH_SECRET=

# Recommended
MONGODB_DB_NAME=focusflow
NEXTAUTH_URL=http://localhost:3000

# Optional OAuth (Google button is hidden when not configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI insights (fallback heuristic is used when unset)
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: protect /api/init index setup endpoint
INIT_API_TOKEN=
